{
  "name": "harbor-auth-learning",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "web": "vite web --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:generate": "auth generate --config ./src/auth-schema.config.ts --output ./src/db/auth-schema.ts --yes",
    "auth:check": "auth check schema --config ./src/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@fastify/cors": "11.3.1",
    "better-auth": "1.7.12",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "auth": "1.7.12",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
