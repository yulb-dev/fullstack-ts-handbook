NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/harbor
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# 使用 openssl rand -base64 32 生成；不要提交真实值。
BETTER_AUTH_SECRET=
MAIL_MODE=local
# MAIL_MODE=resend 时必须配置已验证域名下的发件人和真实 API key。
RESEND_API_KEY=
MAIL_FROM=
# 可选；两个值同时配置才启用 GitHub 登录。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
