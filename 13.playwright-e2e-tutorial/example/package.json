{
  "name": "playwright-e2e-tutorial-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TaskBoard lite —— Playwright E2E 教程配套示例（演示应用 + 端到端测试套件）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "node server/server.js",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:setup": "playwright test --project=setup",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
