# 复制为 .env。真实密钥不入库（.gitignore 已排除）。
# 全部可选：不设置时 API 用内存仓储 + console span，Sentry 禁用发送——零配置可本地演练。

# --- API ---
# DATABASE_URL=postgres://workboard:workboard_dev@localhost:5432/workboard
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# APP_VERSION=1.0.0
# 设置后 span 走 OTLP/HTTP 到 collector（否则打印到 console）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Web（Vite 只暴露 VITE_ 前缀变量；DSN 是公开值，可放前端）---
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# VITE_APP_VERSION=1.0.0

# --- source maps 上传（仅 CI/发布环境，绝不放前端）---
# SENTRY_AUTH_TOKEN=<sntrys_token>
# SENTRY_ORG=<org-slug>
# SENTRY_PROJECT=<project-slug>