{
  "name": "workboard-ci-example",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @workboard/api --filter @workboard/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter=!@workboard/e2e test",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter @workboard/e2e test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
