{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskFlow API",
    "version": "1.3.0",
    "description": "TaskFlow 的 HTTP 契约。所有错误都返回 ErrorResponse；所有时间点都是 UTC ISO 8601。"
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid",
        "description": "登录后由服务端下发的 HttpOnly 会话 Cookie，浏览器自动携带"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "写请求必须携带，值来自 GET /api/v1/auth/session 的 csrfToken"
      }
    },
    "schemas": {
      "ErrorCode": {
        "enum": [
          "VALIDATION_FAILED",
          "BAD_REQUEST",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "CSRF_REJECTED",
          "NOT_FOUND",
          "CONFLICT",
          "IDEMPOTENCY_KEY_REUSED",
          "PRECONDITION_FAILED",
          "PRECONDITION_REQUIRED",
          "RATE_LIMITED",
          "INTERNAL"
        ],
        "description": "机器可读错误码。客户端遇到未知值时必须按 message 兜底展示"
      },
      "FieldError": {
        "type": "object",
        "required": [
          "in",
          "path",
          "rule",
          "message"
        ],
        "properties": {
          "in": {
            "enum": [
              "body",
              "query",
              "params",
              "headers"
            ]
          },
          "path": {
            "type": "string",
            "description": "点号路径，例如 title、tags.0；与 React Hook Form 的字段名一致"
          },
          "rule": {
            "type": "string",
            "description": "失败的规则，例如 minLength、required、format、unique"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string",
                "description": "可直接展示给用户的说明，不含内部细节"
              },
              "requestId": {
                "type": "string",
                "description": "与响应头 X-Request-Id 相同，用于排查"
              },
              "fields": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "LoginBody": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "additionalProperties": false,
        "description": "教学用免密登录：只校验邮箱是否存在。真实项目换成密码/OAuth/Passkey"
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "required": [
          "user",
          "csrfToken"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "csrfToken": {
            "type": "string",
            "description": "写请求必须放进 X-CSRF-Token 请求头（第 8 章）"
          }
        },
        "additionalProperties": false
      },
      "MemberRole": {
        "enum": [
          "owner",
          "editor",
          "viewer"
        ]
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "myRole",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "myRole": {
            "$ref": "#/components/schemas/MemberRole"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC 时间点，ISO 8601 格式，带 Z 后缀",
            "examples": [
              "2026-10-22T08:30:00.000Z"
            ]
          }
        },
        "additionalProperties": false
      },
      "ProjectList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          }
        },
        "additionalProperties": false
      },
      "TaskStatus": {
        "enum": [
          "todo",
          "doing",
          "done"
        ],
        "description": "任务状态。新增取值属于契约变更，客户端需对未知值兜底"
      },
      "TaskPriority": {
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "title",
          "description",
          "status",
          "priority",
          "dueDate",
          "createdBy",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority"
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "description": "日历日期 YYYY-MM-DD，不含时区",
                "examples": [
                  "2026-10-30"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "乐观并发版本号，更新时通过 If-Match 带回"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC 时间点，ISO 8601 格式，带 Z 后缀",
            "examples": [
              "2026-10-22T08:30:00.000Z"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC 时间点，ISO 8601 格式，带 Z 后缀",
            "examples": [
              "2026-10-22T08:30:00.000Z"
            ]
          }
        },
        "additionalProperties": false
      },
      "CreateTaskBody": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority"
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "description": "日历日期 YYYY-MM-DD，不含时区",
                "examples": [
                  "2026-10-30"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "description": "status / createdBy / version 由服务端决定，客户端传了会被拒绝"
      },
      "UpdateTaskBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority"
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "description": "日历日期 YYYY-MM-DD，不含时区",
                "examples": [
                  "2026-10-30"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "TaskPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "不透明游标。原样传回 ?cursor=，不要解析或拼接"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "登录并建立会话",
        "tags": [
          "auth"
        ],
        "description": "成功后通过 Set-Cookie 下发 HttpOnly 会话 Cookie，并在响应体返回 csrfToken。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          }
        },
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "请求格式或字段校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "已登录但无权执行该操作",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getSession",
        "summary": "读取当前会话",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "退出登录",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "cookieAuth": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "204": {
            "description": "已退出"
          },
          "401": {
            "description": "未登录或会话已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "已登录但无权执行该操作",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "【已弃用】读取当前用户，请改用 GET /api/v1/auth/session",
        "tags": [
          "auth"
        ],
        "deprecated": true,
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "listMyProjects",
        "summary": "列出我参与的项目",
        "tags": [
          "projects"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "分页列出项目任务（按创建时间倒序）",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "每页条数，默认 20，最大 100"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "in": "query",
            "name": "cursor",
            "required": false
          },
          {
            "schema": {
              "$ref": "#/components/schemas/TaskStatus"
            },
            "in": "query",
            "name": "status",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "projectId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskPage"
                }
              }
            }
          },
          "400": {
            "description": "请求格式或字段校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在或对当前用户不可见",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTask",
        "summary": "创建任务",
        "tags": [
          "tasks"
        ],
        "description": "必须携带 Idempotency-Key。同一个键 + 相同请求体会重放第一次的结果（响应头 Idempotent-Replayed: true）；同一个键 + 不同请求体返回 422。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskBody"
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "projectId",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "description": "同一次「创建意图」的唯一键；网络重试时必须复用同一个值"
          }
        ],
        "security": [
          {
            "cookieAuth": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "201": {
            "description": "已创建（或幂等重放）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "请求格式或字段校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "已登录但无权执行该操作",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在或对当前用户不可见",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "与现有数据冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "幂等键被用于不同的请求内容",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{taskId}": {
      "get": {
        "operationId": "getTask",
        "summary": "读取单个任务",
        "tags": [
          "tasks"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "taskId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "请求格式或字段校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话已过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在或对当前用户不可见",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateTask",
        "summary": "部分更新任务（乐观并发）",
        "tags": [
          "tasks"
        ],
        "description": "必须携带 If-Match: \"<version>\"。版本不一致返回 412，缺少返回 428。",
        "requestBody": {
