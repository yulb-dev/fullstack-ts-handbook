# 本地 Docker Postgres（见第 2 章）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow

# 允许「跨源」携带 Cookie 访问 API 的浏览器来源（逗号分隔，见第 8 章）。
# 开发期走 Vite 代理、生产走同域反向代理时都是同源，留空即可；
# 只有前端部署在另一个源（例如 https://app.example.com 调 https://api.example.com）时才填写。
WEB_ORIGINS=

# 生产环境必须为 true：Cookie 只走 HTTPS
COOKIE_SECURE=false

# 部署在反向代理之后时设为 true，信任 X-Forwarded-Proto / X-Forwarded-Host（第 8 章）。
# 直接暴露在公网时必须保持 false，否则客户端可以伪造这些头
TRUST_PROXY=false

PORT=3000
LOG_LEVEL=info
